# =============================================================================
# Kuberan Production Environment
# =============================================================================
# Copy this file to .env.prod and fill in all values.
# NEVER commit .env.prod to version control.
# =============================================================================

# -- Cloudflare Tunnel -------------------------------------------------------
# Public ingress is an external Cloudflare tunnel (managed outside this repo).
# Map ONLY public hostnames in the dashboard (see docker-compose.prod.yml):
#   auth.<domain>/oauth2/register -> :8080 (hardened DCR proxy, above the catch-all),
#   auth.<domain> -> :4444, mcp.<domain> -> :8081, app.<domain> -> :3000.
# NEVER map Hydra admin (:4445).

# -- MCP OAuth (Ory Hydra) ---------------------------------------------------
# plan 015-mcp-oauth-hydra. Hydra is the OAuth 2.1 Authorization Server; the
# MCP server is a Resource Server validating Hydra-issued JWTs via JWKS.
#
# Dedicated Hydra database/schema on the same Postgres/Supabase instance.
# Self-hosted example: postgres://kuberan:<pw>@postgres:5432/hydra?sslmode=disable
# Supabase: create a dedicated schema + role in the main postgres database and
# target it via search_path, using the SESSION pooler (port 5432 - Hydra's
# long-lived connections break on the 6543 transaction pooler), e.g.:
#   postgres://hydra_svc.<project-ref>:<pw>@<region>.pooler.supabase.com:5432/postgres?sslmode=require&search_path=hydra
HYDRA_DSN=
# Generate with: openssl rand -hex 32 (Hydra's system secret; rotating it
# invalidates all issued tokens - keep it stable).
HYDRA_SECRETS_SYSTEM=
# Public issuer served by cloudflared. Must be HTTPS and match the AS hostname.
HYDRA_ISSUER_URL=https://auth.kuberan.example.com
# Hydra admin API, reached by the api container over the private Docker
# network for the login/consent bridge and DCR proxy. NEVER expose publicly.
HYDRA_ADMIN_URL=http://hydra:4445
# Login & consent pages (apps/web), served by cloudflared.
HYDRA_LOGIN_URL=https://app.kuberan.example.com/oauth/login
HYDRA_CONSENT_URL=https://app.kuberan.example.com/oauth/consent
# Public MCP Resource Server URL; tokens must carry this as their audience.
MCP_RESOURCE_URL=https://mcp.kuberan.example.com
# Docker network CIDR cloudflared connects from (X-Forwarded-Proto trust).
# Docker's default bridge pool is 172.16.0.0/12; adjust if you customized it.
HYDRA_TLS_TERMINATION_CIDR=172.16.0.0/12

# -- API Configuration -------------------------------------------------------
ENV=production
PORT=8080

# Generate with: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m

# Generate with: openssl rand -hex 32
# Must match the oracle's PIPELINE_API_KEY
PIPELINE_API_KEY=

# Restrict CORS to your domain in production
CORS_ORIGIN=https://kuberan.example.com

# -- Database ----------------------------------------------------------------
# Choose ONE of the options below and comment out the other.
# See docs/database-setup.md for full setup instructions.

# OPTION A: Self-hosted PostgreSQL (recommended for full self-hosting)
# Runs a local Postgres 16 container managed by Docker Compose.
# Set COMPOSE_PROFILES=postgres to activate the postgres service.
# Add 'backup' to enable automated daily backups (e.g., COMPOSE_PROFILES=postgres,backup).
# COMPOSE_PROFILES=postgres,backup
# DB_HOST=postgres
# DB_PORT=5432
# DB_USER=kuberan
# DB_PASSWORD=        # Generate: openssl rand -hex 32
# DB_NAME=kuberan
# DB_SSLMODE=disable

# OPTION B: Supabase (managed database)
# Connection pooling via Supavisor (transaction mode, port 6543).
# The deploy script automatically overrides to port 5432 (direct) for migrations,
# since golang-migrate requires advisory locks not supported by Supavisor.
# Find these in: Supabase Dashboard > Settings > Database
# Add 'backup' to enable automated daily backups (e.g., COMPOSE_PROFILES=backup).
COMPOSE_PROFILES=
DB_HOST=db.xxxxxxxxxxxx.supabase.co
DB_PORT=6543
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=
DB_NAME=postgres
DB_SSLMODE=require

# -- Frontend ----------------------------------------------------------------
# Inlined at build time by Next.js. Must match your domain.
NEXT_PUBLIC_API_URL=https://kuberan.example.com
