# =============================================================================
# Kuberan public demo (docker-compose.demo.yml). See docs/public-demo.md.
# Copy to .env.demo and fill in. Everything here is for a THROWAWAY instance:
# the database is dropped every night, so never reuse production values.
# =============================================================================

# Generate with: openssl rand -hex 32
JWT_SECRET=
# Generate with: openssl rand -hex 16 (only the demo database uses it)
DB_PASSWORD=

# Public origins. NEXT_PUBLIC_API_URL is inlined into the web build; CORS_ORIGIN
# is the exact web origin the api accepts.
NEXT_PUBLIC_API_URL=https://demo-api.kuberan.example.com
CORS_ORIGIN=https://demo.kuberan.example.com

# The shared demo login. It is PUBLIC (publish it on the landing page and the
# login screen), so use a throwaway password (min 8 characters).
DEMO_EMAIL=demo@kuberan.example.com
DEMO_PASSWORD=
# DEMO_FIRST_NAME=Demo
# Reporting currency of the demo user. Empty = MYR. USD always works; any other
# currency needs an FX rate, which a demo without the oracle does not have.
# DEMO_BASE_CURRENCY=

# Behind a reverse proxy or tunnel, trust its network for client IPs (rate limits).
# API_TRUSTED_PROXY_CIDRS=
# Address and host ports the stack publishes (loopback by default).
# PUBLISH_ADDRESS=127.0.0.1
# DEMO_WEB_PORT=3000
# DEMO_API_PORT=8080
# DEFAULT_PALETTE=catppuccin
# RATE_LIMIT_REGISTER_PER_HOUR=10
